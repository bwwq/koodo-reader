FROM golang:1.25-alpine AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY service ./service
RUN go test ./service
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/koodo-service ./service

FROM alpine:3.22
RUN addgroup -S koodo && adduser -S -G koodo koodo && mkdir -p /data && chown -R koodo:koodo /data
COPY --from=builder /out/koodo-service /usr/local/bin/koodo-service
USER koodo
VOLUME ["/data"]
EXPOSE 8081
ENV SERVICE_PORT=8081 SERVICE_DB=/data/service.db
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:8081/v1/health || exit 1
ENTRYPOINT ["/usr/local/bin/koodo-service"]
